# ===== Supabase =====
# Copie este arquivo para .env e preencha com suas credenciais reais.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ===== IA / análise do pipeline (via OpenRouter) =====
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ===== API interna do FunilPro =====
FUNILPRO_API_KEY=fp_live_xxxxxxxxxxxxxxxxxxxx

# ===== Sessão / JWT (assinatura dos tokens de login) =====
JWT_SECRET=gere-um-segredo-aleatorio-forte

# ===== Notificação por e-mail (SMTP Gmail) =====
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=senha-de-app-16-digitos
EMAIL_DESTINO=destino@gmail.com
